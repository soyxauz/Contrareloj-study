# Google Cloud OAuth 2.0 Web Client ID
# Consigue tu ID gratuito en: https://console.cloud.google.com/apis/credentials
# Asegurate de autorizar http://localhost:5173 en "Origenes de JavaScript autorizados"
VITE_GOOGLE_CLIENT_ID=

# Groq API Key (para lecciones orales y procesamiento ultra acelerado)
# Consigue tu clave gratuita en: https://console.groq.com/keys
VITE_GROQ_API_KEY=

# Gemini API Key (opcional, para modelos Google Gemini)
# Consigue tu clave en: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
